  "problemstilling": {
    "omraade": "Operasjonell planlegging, ressursallokering og produksjonsplanlegging",
    "beskrivelse": "Fylkeskartkontorene i Kartverket skal gjennomføre et kvalitetshevingsprosjekt av datasettet TraktorvegSti, der datasettet etter kvalitetsheving skal implementeres i NVDB (Norsk Vegdatabank). Kvalitetshevingens mål er at traktorveger og stier skal inngå sammen med veger i et nasjonalt vegnettverk for kjørende, gående og syklende. Arbeidet utføres kommunevis ved 10 fylkeskartkontorer med varierende kapasitet, og kompliseres av Geovekst-prosjekter som låser kommuner i perioder.",
    "maalfunksjon": [
      "Minimere total prosjektvarighet for hele landet",
      "Utnytte kapasiteten ved kartkontorene best mulig",
      "I minst mulig grad utføre kvalitetsheving i perioder der kommuner er låst pga. kartleggingsprosjekter",
      "Sikre jevn arbeidsbelastning"
    ],
    "beslutningsvariabler": [
      "Tildeling av kommuner til hvert kartkontor",
      "Rekkefølge på hvilke kommuner som behandles når",
      "Ressursallokering basert på kontorenes kapasitet",
      "Justeringer i produksjonsrekkefølge pga. Geovekst-prosjekter"
    ],
    "avgrensninger": [
      "Ulike personer har ulik effektivitet - dette tas ikke hensyn til i prosjektet",
      "Kartleggingsprosjekter kan endre seg fortløpende, tidsskjema kan endre seg",
      "All produksjon må ferdigstilles kommunevis",
      "Selve innleggingen i NVDB ligger utenfor prosjektets omfang"
    ]
  },
